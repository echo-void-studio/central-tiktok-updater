"""Central TikTok Watch: experimental AyuGram/exteraGram plugin.
Detects Private Plus ARM8 APK releases; does not download/install APKs.
"""
import re
import time
import traceback

from base_plugin import BasePlugin, HookResult, MenuItemData, MenuItemType, AppEvent
from client_utils import run_on_queue
from ui.settings import Header, Switch, Text

__id__ = "central_tiktok_watch"
__name__ = "Central TikTok Watch"
__description__ = "Private Plus ARM8 updates in @CentralTikTok (no separate API credentials)."
__author__ = "echo-void-studio"
__version__ = "0.2.5"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["tools"]

CHANNEL_URL = "https://t.me/CentralTikTok"
PUBLIC_FEED = "https://t.me/s/CentralTikTok"
CHECK_INTERVAL = 86400
APK = re.compile(r"TikTok_Private_Plus_v(\d+(?:\.\d+){1,4})_\(MOD\)_arm8\.apk", re.I)

def version_from_name(name):
    found = APK.search(str(name or ""))
    return tuple(map(int, found.group(1).split("."))) if found else None

def version_text(version):
    return ".".join(map(str, version)) if version else ""

def attached_apk_name(msg):
    try:
        owner = getattr(msg, "messageOwner", msg)
        doc = getattr(getattr(owner, "media", None), "document", None)
        if not doc:
            return None
        for attr in doc.attributes:
            name = getattr(attr, "file_name", None)
            if name and name.lower().endswith(".apk"):
                return name
    except Exception:
        pass
    return None

def extract_release(msg):
    name = attached_apk_name(msg)
    v = version_from_name(name)
    return (v, name) if v else None

def parse_public_feed(html):
    """Scrape only actual Telegram document titles inside CentralTikTok posts."""
    from bs4 import BeautifulSoup
    soup = BeautifulSoup(html, "html.parser")
    results = []
    for post in soup.select(".tgme_widget_message[data-post]"):
        post_ref = post.get("data-post", "")
        if not post_ref.lower().startswith("centraltiktok/"):
            continue
        id_str = post_ref.split("/")[-1]
        if not id_str.isdigit():
            continue
        for title in post.select(".tgme_widget_message_document_title"):
            name = title.get_text(" ", strip=True)
            v = version_from_name(name)
            if v:
                results.append((v, int(id_str), name))
    return max(results, key=lambda item: (item[0], item[1])) if results else None

class CentralTikTokWatch(BasePlugin):
    def on_plugin_load(self):
        self.add_hook("TL_updateNewChannelMessage")
        self.add_hook("TL_updateEditChannelMessage")
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="Отслеживать Private Plus ARM8",
            on_click=self._watch_from_message,
            icon="msg_info",
        ))
        self.log("CentralTikTokWatch loaded")

    def create_settings(self):
        return [
            Header(text="Central TikTok Watch (prototype 0.2.5)"),
            Switch(key="notifications_enabled", text="Уведомлять о новых версиях",
                   default=True),
            Switch(key="daily_fallback", text="Проверка публичной страницы раз в сутки",
                   default=True, subtext="Только когда AyuGram запущен"),
            Text(text="Канал", subtext=(
                "Привязан: " + str(self.get_setting("watch_dialog")) if
                self.get_setting("watch_dialog") else
                "@CentralTikTok (автопривязка при новом сообщении)")),
            Text(text="Последняя найденная версия",
                 subtext=str(self.get_setting("last_version", "Не задана"))),
            Text(text="Последний результат", subtext=str(self.get_setting(
                "last_check_result", "Проверок ещё не было"))),
            Header(text="Диагностика Android"),
            Text(text="Результат отправки", subtext=str(self.get_setting(
                "notification_result", "Не проверялось"))),
            Text(text="Сразу после отправки", subtext=str(self.get_setting(
                "notification_immediate", "Не проверялось"))),
            Text(text="Повторная проверка", subtext=str(self.get_setting(
                "notification_later", "Не проверялось"))),
            Text(text="Отложенный тест", subtext=str(self.get_setting(
                "notification_delayed", "Не проверялось"))),
            Text(text="Канал и разрешение", subtext=str(self.get_setting(
                "notification_permission", "Не проверялось"))),
            Text(text="Проверить сейчас", on_click=self._manual_check),
            Text(text="Тест уведомления", on_click=self._test_notification),
            Text(text="Тест с задержкой (3 секунды)", on_click=self._test_delayed_notification),
            Text(text="Проверить активное уведомление",
                 on_click=self._check_active_notification),
            Text(text="Открыть настройки уведомлений Android",
                 on_click=self._open_notification_settings),
        ]

    def _watch_from_message(self, context):
        msg = context.get("message")
        if not msg:
            self._info("Открой сообщение с Private Plus ARM8 APK")
            return
        try:
            owner = getattr(msg, "messageOwner", msg)
            channel = int(getattr(getattr(owner, "peer_id", None), "channel_id", 0) or 0)
            dialog = int(context.get("dialog_id") or (-channel if channel else 0))
            account = int(context.get("account", 0) or 0)
            if dialog >= 0:
                self._info("Выбери пост канала @CentralTikTok")
                return
            from client_utils import get_messages_controller
            chat = context.get("chat") or get_messages_controller(account).getChat(-dialog)
            username = str(getattr(chat, "username", "") or "").lstrip("@").lower()
            if username != "centraltiktok":
                self._info("Выбери именно @CentralTikTok")
                return
            self.set_setting("watch_dialog", dialog)
            self.set_setting("last_check_result", "Канал привязан. Можно проверить сейчас.")
            self.set_setting("watch_account", account)
            release = extract_release(msg)
            if release:
                v, _ = release
                self.set_setting("last_version", version_text(v))
                self.set_setting("last_post", int(msg.getId()))
                self._info("Канал привязан, базовая версия: " + version_text(v))
            else:
                self._info("Канал привязан. Выбери пост с нужным APK для базовой версии")
            self.set_setting("last_public_check", 0)
        except Exception as exc:
            self.set_setting("last_check_result", "Ошибка привязки: " + str(exc)[:130])
            self.log("Could not bind CentralTikTok channel: " + traceback.format_exc())
            self._info("Ошибка привязки. Подробности — в настройках.")

    def on_update_hook(self, update_name, account, update):
        if update_name not in ("TL_updateNewChannelMessage", "TL_updateEditChannelMessage"):
            return HookResult()
        try:
            expected = int(self.get_setting("watch_dialog", 0) or 0)
            expected_account = int(self.get_setting("watch_account", 0) or 0)
            msg = update.message
            channel = int(getattr(getattr(msg, "peer_id", None), "channel_id", 0) or 0)
            if not channel:
                return HookResult()
            if expected < 0:
                if account != expected_account or -channel != expected:
                    return HookResult()
            else:
                # First update from @CentralTikTok: bind automatically if cached.
                from client_utils import get_messages_controller
                chat = get_messages_controller(account).getChat(channel)
                username = str(getattr(chat, "username", "") or "").lstrip("@").lower()
                if username != "centraltiktok":
                    return HookResult()
                self.set_setting("watch_dialog", -channel)
                self.set_setting("watch_account", account)
                self.set_setting("last_check_result",
                                 "Канал @CentralTikTok привязан автоматически")
            release = extract_release(msg)
            if release:
                v, name = release
                message_id = int(getattr(msg, "id", 0) or 0)
                run_on_queue(lambda: self._accept(v, message_id, name))
        except Exception:
            self.log("Telegram hook failed: " + traceback.format_exc())
        return HookResult()

    def on_app_event(self, event_type):
        if event_type not in (AppEvent.START, AppEvent.RESUME):
            return
        if not self.get_setting("daily_fallback", True):
            return
        if not self.get_setting("watch_dialog", None):
            return
        now = int(time.time())
        last = int(self.get_setting("last_public_check", 0) or 0)
        if now - last >= CHECK_INTERVAL:
            self.set_setting("last_public_check", now)
            run_on_queue(self._check_public)

    def _manual_check(self, view=None):
        self.set_setting("last_check_result", "Проверка запущена…")
        self._info("Проверяю CentralTikTok...")
        run_on_queue(self._check_public)

    def _test_notification(self, view=None):
        self.set_setting("notification_result", "Запускается тест…")
        post = int(self.get_setting("last_post", 2336) or 2336)
        self._notify("Тест", post, notification_id=47151)
        self._info("Тест отправлен. Проверь шторку и нажми «Проверить активное уведомление»")

    def _test_delayed_notification(self, view=None):
        """Post after the settings UI settles; later check whether it survives."""
        from android_utils import run_on_ui_thread
        self.set_setting("notification_delayed", "Ожидание публикации 3 секунды…")
        post = int(self.get_setting("last_post", 2336) or 2336)

        def post_later():
            self._notify("Отложенный тест", post, notification_id=47152)
            self.set_setting("notification_delayed",
                "Отправлено через 3 секунды. Проверяю через 4 секунды.")

        def inspect_later():
            try:
                from android.content import Context
                from org.telegram.messenger import ApplicationLoader
                ctx = ApplicationLoader.applicationContext
                manager = ctx.getSystemService(Context.NOTIFICATION_SERVICE)
                active = list(manager.getActiveNotifications())
                ours = [int(item.getId()) for item in active
                        if int(item.getId()) in (47150, 47151, 47152)]
                self.set_setting("notification_delayed",
                    "Через 4 с: наших ID %s; всего %d" %
                    (",".join(map(str, ours)) if ours else "НЕТ", len(active)))
            except Exception as exc:
                self.set_setting("notification_delayed",
                    "Ошибка: %s: %s" % (type(exc).__name__, str(exc)[:80]))
                self.log("Delayed scan failed: " + traceback.format_exc())

        run_on_ui_thread(post_later, 3000)
        run_on_ui_thread(inspect_later, 7000)
        self._info("Через 3 сек будет тест; не закрывай AyuGram 8 секунд")

    def _check_active_notification(self, view=None):
        """Read current notification state after the test; no changes to notifications."""
        try:
            from android.content import Context
            from android.os import Build
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            manager = ctx.getSystemService(Context.NOTIFICATION_SERVICE)
            channel_id = "central_tiktok_watch_alerts_v2"
            allowed = bool(manager.areNotificationsEnabled()) if Build.VERSION.SDK_INT >= 24 else True
            importance = -1
            if Build.VERSION.SDK_INT >= 26:
                channel = manager.getNotificationChannel(channel_id)
                importance = int(channel.getImportance()) if channel is not None else -1
            self.set_setting("notification_permission",
                "Разрешено: %s; приоритет канала: %s" %
                ("да" if allowed else "НЕТ", importance))
            if Build.VERSION.SDK_INT >= 23:
                active = list(manager.getActiveNotifications())
                ours = [int(item.getId()) for item in active
                        if int(item.getId()) in (47150, 47151, 47152)]
                self.set_setting("notification_later",
                    "Всего: %d; наши: %s" %
                    (len(active), ",".join(map(str, ours)) if ours else "НЕТ"))
            else:
                self.set_setting("notification_later", "Версия Android не поддерживает проверку")
            self._info("Проверка завершена. Открой настройки плагина ещё раз.")
        except Exception as exc:
            self.set_setting("notification_later",
                "ОШИБКА %s: %s" % (type(exc).__name__, str(exc)[:75]))
            self.log("Active notification check failed: " + traceback.format_exc())
            self._info("Диагностика завершилась ошибкой")

    def _open_notification_settings(self, view=None):
        try:
            from android.content import Intent
            from android.provider import Settings
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            intent = Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS)
            intent.putExtra(Settings.EXTRA_APP_PACKAGE, ctx.getPackageName())
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            ctx.startActivity(intent)
        except Exception as exc:
            self.set_setting("notification_result",
                             "Не удалось открыть настройки: " + str(exc)[:140])
            self.log("Notification settings launch failed: " + traceback.format_exc())
            self._info("Открой Настройки Android → Приложения → AyuGram → Уведомления")

    def _check_public(self):
        try:
            import requests
            posts_seen = 0
            before_id = None
            found = None
            pages = 0
            for _ in range(6):
                params = {"before": before_id} if before_id else {}
                response = requests.get(
                    PUBLIC_FEED, params=params, timeout=15,
                    headers={"User-Agent": "Mozilla/5.0 (Android; CentralTikTokWatch/0.2)"})
                response.raise_for_status()
                html = response.text
                pages += 1
                ids = [int(n) for n in re.findall(
                    r'data-post="CentralTikTok/([0-9]+)"', html, re.I)]
                posts_seen += len(ids)
                found = parse_public_feed(html)
                if found:
                    break
                next_before = min(ids) if ids else None
                if not next_before or (before_id is not None and next_before >= before_id):
                    break
                before_id = next_before
            if found:
                version, message_id, filename = found
                self.set_setting(
                    "last_check_result",
                    "Найдена версия %s; пост %s; просмотрено %s постов" %
                    (version_text(version), message_id, posts_seen))
                self._accept(version, message_id, filename)
                self._info("Найдена Private Plus ARM8 " + version_text(version))
            else:
                message = ("APK Private Plus ARM8 не найден в %s постах (%s стр.). "
                           "Следующие сообщения @CentralTikTok будут проверяться в AyuGram." %
                           (posts_seen, pages))
                self.set_setting("last_check_result", message)
                self._info(message)
        except Exception as exc:
            self.set_setting(
                "last_check_result", "Ошибка %s: %s" %
                (type(exc).__name__, str(exc)[:160]))
            self.log("Public check failed: " + traceback.format_exc())
            self._info("Не удалось проверить канал. Причина сохранена в настройках.")

    def _accept(self, version, message_id, filename):
        try:
            old = str(self.get_setting("last_version", "") or "")
            previous = tuple(map(int, old.split("."))) if old else ()
            if previous and version <= previous:
                return
            self.set_setting("last_version", version_text(version))
            self.set_setting("last_post", int(message_id))
            self.log("Found %s %s" % (filename, version_text(version)))
            if self.get_setting("notifications_enabled", True):
                self._notify(version_text(version), int(message_id))
        except Exception:
            self.log("Could not store version: " + traceback.format_exc())

    def _info(self, message):
        try:
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_info(message)
        except Exception:
            self.log(message)

    def _notify(self, version, message_id, notification_id=47150):
        try:
            from android.app import Notification, NotificationChannel, NotificationManager, PendingIntent
            from android.content import Context, Intent
            from android.net import Uri
            from android.os import Build
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            manager = ctx.getSystemService(Context.NOTIFICATION_SERVICE)
            if Build.VERSION.SDK_INT >= 33:
                permission = ctx.checkSelfPermission("android.permission.POST_NOTIFICATIONS")
                if permission != 0:
                    raise RuntimeError("Нет разрешения POST_NOTIFICATIONS для AyuGram (Android 13+)")
            if Build.VERSION.SDK_INT >= 24 and not manager.areNotificationsEnabled():
                raise RuntimeError("Уведомления AyuGram отключены в Android")
            # New channel ID: Android does not allow changing importance of an old channel.
            channel_id = "central_tiktok_watch_alerts_v2"
            if Build.VERSION.SDK_INT >= 26:
                manager.createNotificationChannel(NotificationChannel(
                    channel_id, "TikTok Private Plus updates", NotificationManager.IMPORTANCE_HIGH))
                channel = manager.getNotificationChannel(channel_id)
                if channel is None:
                    raise RuntimeError("Android не создал канал уведомлений")
                if channel.getImportance() == NotificationManager.IMPORTANCE_NONE:
                    raise RuntimeError("Канал TikTok Private Plus updates отключён в Android")
                builder = Notification.Builder(ctx, channel_id)
            else:
                builder = Notification.Builder(ctx)
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(CHANNEL_URL + "/" + str(message_id)))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            flags = PendingIntent.FLAG_UPDATE_CURRENT
            if Build.VERSION.SDK_INT >= 23:
                flags |= PendingIntent.FLAG_IMMUTABLE
            pending = PendingIntent.getActivity(ctx, message_id, intent, flags)
            if Build.VERSION.SDK_INT < 26:
                builder.setPriority(Notification.PRIORITY_HIGH)
            # Telegram uses its own monochrome notification glyph. A launcher icon
            # can be adaptive and unsupported as a status-bar notification small icon.
            from org.telegram.messenger import R as TelegramR
            icon_id = int(TelegramR.drawable.notification)
            builder.setSmallIcon(icon_id)
            builder.setContentTitle("Private Plus ARM8: " + version)
            builder.setContentText("Новый APK в CentralTikTok — открыть пост")
            builder.setContentIntent(pending)
            builder.setAutoCancel(True)
            notif = builder.build()
            manager.notify(notification_id, notif)
            self.set_setting("notification_result",
                "notify() вернул управление; ID %d" % notification_id)
            if Build.VERSION.SDK_INT >= 23:
                try:
                    active = list(manager.getActiveNotifications())
                    current_ids = [int(item.getId()) for item in active]
                    self.set_setting("notification_immediate",
                        "Наш ID: %s; всего: %d; иконка: %d" %
                        ("ЕСТЬ" if notification_id in current_ids else "НЕТ",
                         len(current_ids), icon_id))
                except Exception as scan_exc:
                    self.set_setting("notification_immediate",
                        "Ошибка чтения: " + str(scan_exc)[:80])
            else:
                self.set_setting("notification_immediate",
                                 "Android ниже 6.0: недоступно")
        except Exception as exc:
            self.set_setting("notification_result",
                "ОШИБКА %s: %s" % (type(exc).__name__, str(exc)[:110]))
            self.log("Android notification failed: " + traceback.format_exc())
            self._info("Ошибка системного уведомления — открой настройки плагина")
